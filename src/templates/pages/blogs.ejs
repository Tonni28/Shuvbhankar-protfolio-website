<section class="page-hero blog-hero"><div class="container page-hero-grid"><div><p class="eyebrow"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1></div><div><p class="hero-lead"><%= page.data.lead %></p><p>Personal reflections—not institutional statements or formal research papers.</p></div></div></section>
<section class="section archive-section"><div class="container"><div class="filter-bar" data-filter-bar><label class="search-field"><span>Search the journal</span><input type="search" placeholder="Search ideas, subjects or titles" data-article-search></label><fieldset><legend>Browse by theme</legend><div class="filter-options"><% page.data.categories.forEach((topic, index) => { %><label><input type="radio" name="topic" value="<%= topic %>" <%= index===0?'checked':'' %>><span><%= topic %></span></label><% }) %></div></fieldset></div><% const posts=articles.filter(a=>a.type==='blog'); %><% if (posts.length) { %><div class="article-grid" data-article-grid><% posts.forEach((article) => { %><%- include('../components/article-card.ejs', { article }) %><% }) %></div><p class="empty-state" data-empty-state hidden>Nothing in this collection yet. Try another topic or return to all writing.</p><% } else { %><div class="empty-editorial"><p class="eyebrow">Editorial review in progress</p><h2>The first field notes are being prepared.</h2><p>Five complete drafts are held for author approval and are not shown in the public archive.</p></div><% } %></div></section>

