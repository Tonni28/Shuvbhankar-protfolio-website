<section class="support-page section"><div class="container support-inner"><p class="eyebrow"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1><% if (page.data.notice) { %><p class="status-pill"><%= page.data.notice %></p><% } %><div class="prose prose-large"><% page.data.paragraphs.forEach((paragraph) => { %><p><%= paragraph %></p><% }) %></div><% if (page.data.actions) { %><div class="hero-actions"><a class="button button-gold" href="<%= urlFor('/') %>">Return Home</a><a class="text-link" href="<%= urlFor('/insights/') %>">Explore Insights <span aria-hidden="true">↗</span></a></div><% } else { %><a class="arrow-link" href="<%= urlFor('/contact/') %>">Contact the site owner <span aria-hidden="true">↗</span></a><% } %></div></section>
