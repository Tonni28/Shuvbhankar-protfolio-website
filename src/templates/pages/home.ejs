<section class="home-hero section-dark">
  <div class="container home-hero-grid">
    <div class="hero-stage">
      <h1 class="hero-title hero-title-back" aria-label="I began with numbers. The work has always been about people.">
        <span class="hero-title-line">I began with <em>numbers.</em></span>
        <span class="hero-title-line">The work has always</span>
        <span class="hero-title-line">been about <strong>people.</strong></span>
      </h1>
      <figure class="hero-portrait">
        <img src="<%= asset('assets/images/profile/shubhankar-shil-chair-v3.png') %>" width="1024" height="971" alt="Portrait of Shubhankar Shil wearing a suit, smiling toward the camera.">
      </figure>
    </div>
    <div class="hero-copy">
      <p class="hero-intro"><%= page.data.lead %></p>
      <div class="hero-actions"><a class="button button-gold" href="<%= urlFor('/about/') %>">Discover my story</a><a class="text-link text-link-light" href="<%= urlFor('/work/') %>">Explore my work <span aria-hidden="true">&#8599;</span></a></div>
    </div>
  </div>
</section>
<section class="section story-thread"><div class="container split-heading"><div><p class="eyebrow">A thread through the years</p><h2><%= page.data.threadHeading %></h2></div><div class="prose-large"><% page.data.threadCopy.forEach((p) => { %><p><%= p %></p><% }) %><p class="pull-line">The work is never only about systems. It is also about the people expected to make those systems work.</p></div></div></section>
<section class="section threads"><div class="container"><header class="section-heading"><p class="eyebrow">Where my work meets</p><h2>Three paths. <em>One continuing conversation.</em></h2></header><div class="thread-grid"><% page.data.threads.forEach((item) => { %><article class="thread-card"><span class="card-number"><%= item.number %></span><p class="eyebrow"><%= item.label %></p><h3><%= item.title %></h3><p><%= item.body %></p><a class="arrow-link" href="<%= urlFor(item.route) %>#<%= item.anchor %>">Explore <span aria-hidden="true">&#8599;</span></a></article><% }) %></div></div></section>
<section class="statement-band"><div class="container"><p class="eyebrow eyebrow-light">What connects it all</p><blockquote><%= page.data.statement %></blockquote></div></section>
<section class="section journey"><div class="container journey-grid"><div class="journey-intro"><p class="eyebrow">Selected milestones</p><h2>The journey,<br><em>in chapters.</em></h2><a class="button button-outline" href="<%= urlFor('/about/') %>">Read the full journey</a></div><ol class="timeline"><% page.data.milestones.forEach((item) => { %><li><span class="timeline-year"><%= item.year %></span><div><h3><%= item.title %></h3><p><%= item.body %></p></div></li><% }) %></ol></div></section>
<section class="home-research-cta">
  <div class="container home-research-cta-inner">
    <div>
      <p class="eyebrow">Research & publications</p>
      <h2>Questions examined with evidence.</h2>
    </div>
    <div>
      <p>Explore research into governance, accounting, finance and the institutional conditions that shape business decisions.</p>
      <a class="button button-outline" href="<%= urlFor('/insights/research/') %>">Explore research</a>
    </div>
  </div>
</section>
<% const speakingPage = pages.find((item) => item.route === '/speaking/'); const homeVideos = speakingPage.data.videos.slice(0, 2); %>
<section class="section section-dark home-videos-section">
  <div class="container">
    <div class="speaking-section-heading speaking-section-heading-dark">
      <div>
        <p class="eyebrow eyebrow-light">Video conversations</p>
        <h2>Practical ideas for work, careers and business.</h2>
      </div>
      <a class="text-link text-link-light" href="<%= urlFor('/speaking/') %>#video-conversations">Explore all videos <span aria-hidden="true">&#8599;</span></a>
    </div>
    <div class="speaking-video-grid">
      <% homeVideos.forEach((video) => { %>
        <article class="speaking-video-card">
          <div class="speaking-video">
            <iframe src="https://www.youtube-nocookie.com/embed/<%= video.id %>" title="<%= video.title %>" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          </div>
          <div class="speaking-video-card-copy">
            <h3><%= video.title %></h3>
            <a class="arrow-link arrow-light" href="<%= video.url %>" target="_blank" rel="noopener noreferrer">Watch on YouTube <span aria-hidden="true">&#8599;</span></a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<section class="section writing-preview"><div class="container"><div class="split-heading"><div><p class="eyebrow">Blogs & insights</p><h2>Ideas from the work.<br><em>Questions worth keeping.</em></h2></div></div><% const homeBlogs = allArticles.filter((article) => article.type === 'blog').slice(0, 2); const homeInsights = allArticles.filter((article) => article.type === 'insight').slice(0, 2); %><section class="home-writing-group" aria-label="Blogs"><div class="article-grid"><% homeBlogs.forEach((article) => { %><%- include('../components/article-card.ejs', { article }) %><% }) %></div><div class="section-actions"><a class="button button-outline" href="<%= urlFor('/blogs/') %>">Browse blogs</a></div></section><section class="home-writing-group" aria-label="Insights"><div class="article-grid"><% homeInsights.forEach((article) => { %><%- include('../components/article-card.ejs', { article }) %><% }) %></div><div class="section-actions"><a class="button button-outline" href="<%= urlFor('/insights/') %>">Explore insights</a></div></section></div></section>
<%- include('../components/cta.ejs', { cta: { eyebrow: 'Start a conversation', title: 'Progress is not something we build alone.', body: 'Good ideas need people willing to test them. Institutions need systems that earn trust.', label: 'Let\'s connect' } }) %>


