<section class="hero-minimal section-dark" data-hero>
  <div class="container hero-minimal-grid">
    <div class="hero-minimal-copy">
      <div class="hero-story-layout">
        <div class="hero-story-primary">
          <h1><%= page.data.heroHeading %></h1>
          <div class="hero-bridge-list"><% page.data.heroBridges.forEach((bridge) => { %><p><%= bridge %></p><% }) %></div>
        </div>
        <div class="hero-story-right">
          <figure class="hero-portrait-stage">
            <img src="<%= asset('assets/images/profile/shubhankar-shil-chair-v3.png') %>" width="1024" height="1536" alt="Shubhankar Shil seated in a brown leather chair, smiling toward the camera">
          </figure>
          <div class="hero-story-secondary">
            <p class="hero-minimal-lead"><%= page.data.heroLead %></p>
            <p class="hero-story-closing"><%= page.data.heroClosing %></p>
            <div class="hero-actions"><a class="button button-gold" href="<%= urlFor('/about/') %>">Read My Story</a><a class="text-link text-link-light" href="<%= urlFor('/advisory/') %>">Explore My Impact <span aria-hidden="true">↗</span></a></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="credential-strip" aria-label="Selected credentials"><div class="container"><ul><% page.data.credentials.forEach((item) => { %><li><%= item %></li><% }) %></ul></div></section>

<section class="editorial-intro section"><div class="container split-layout"><div><p class="eyebrow">One philosophy. Multiple domains.</p><h2>Stronger institutions begin with clearer thinking.</h2></div><div><p class="large-copy"><%= page.data.thesis %></p><a class="arrow-link" href="<%= urlFor('/about/') %>">Read My Story <span aria-hidden="true">↗</span></a></div></div></section>

<section class="pillars section"><div class="container"><div class="section-kicker"><p class="eyebrow">Three dimensions of work</p><p>One commitment to meaningful progress.</p></div><div class="pillar-layout"><% page.data.pillars.forEach((pillar, index) => { %><article class="pillar-card pillar-<%= index + 1 %>"><div class="pillar-top"><span><%= pillar.number %></span><span><%= pillar.label %></span></div><h2><%= pillar.title %></h2><p><%= pillar.body %></p><a class="arrow-link" href="<%= urlFor(pillar.route) %>"><%= pillar.cta %> <span aria-hidden="true">↗</span></a></article><% }) %></div></div></section>

<section class="philosophy section-dark section"><div class="container philosophy-grid"><div><p class="eyebrow eyebrow-light">A working philosophy</p><h2>Systems matter.<br>So do people.</h2></div><div><p class="large-copy">Effective organizations need clear responsibilities, usable information, disciplined implementation and leaders willing to learn. Meaningful education requires curiosity, application and critical judgment.</p><ol><% page.data.principles.forEach((principle, index) => { %><li><span>0<%= index + 1 %></span><%= principle %></li><% }) %></ol></div></div></section>

<section class="featured section"><div class="container featured-grid"><div class="featured-copy"><p class="eyebrow">Featured thinking</p><% if (articles.length) { const feature = articles[0]; %><p class="status-pill">Preview · Author review</p><h2><%= feature.title %></h2><p class="large-copy"><%= feature.description %></p><a class="button button-outline" href="<%= urlFor(feature.route) %>">Read the Insight</a><% } else { %><h2>Research translated into practice.</h2><p class="large-copy">Explore peer-reviewed work on governance, finance and organizational performance through verified publisher sources.</p><a class="button button-outline" href="<%= urlFor('/academia/') %>">Explore Research</a><% } %></div><aside class="research-spotlight"><p class="eyebrow">Research spotlight</p><span class="research-year">2024</span><h3>Board Independence and Corporate Performance: Lessons from Bangladesh</h3><p>A research perspective grounded in a Springer chapter co-authored by Shubhankar Shil.</p><a class="arrow-link" href="https://doi.org/10.1007/978-3-031-67547-8_5" target="_blank" rel="noopener noreferrer">View publication <span aria-hidden="true">↗</span></a></aside></div></section>

<%- include('../components/cta.ejs', { cta: { eyebrow: 'Conversations that matter', title: 'Let’s turn thoughtful questions into meaningful progress.', body: 'Whether you represent an organization, an academic institution or a community of learners, a productive exchange begins with a clear question.', label: 'Start a Conversation' } }) %>
