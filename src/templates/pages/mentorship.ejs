<section class="page-hero mentorship-hero"><div class="container page-hero-grid"><div><p class="eyebrow"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1></div><p class="hero-lead"><%= page.data.lead %></p></div></section>
<section class="section"><div class="container split-layout"><div><p class="eyebrow">Mentorship philosophy</p><h2>Preparation creates opportunity; judgment sustains it.</h2></div><div class="prose prose-large"><% page.data.philosophy.forEach((paragraph) => { %><p><%= paragraph %></p><% }) %></div></div></section>
<section class="section section-dark"><div class="container"><div class="section-heading narrow"><p class="eyebrow eyebrow-light">Learning pathways</p><h2>Support appropriate to the stage.</h2></div><ol class="pathway-list"><% page.data.pathways.forEach((path, index) => { %><li><span>0<%= index + 1 %></span><p class="eyebrow eyebrow-light"><%= path.audience %></p><h3><%= path.stage %></h3><p><%= path.body %></p></li><% }) %></ol></div></section>
<section class="section"><div class="container resources-layout"><div><p class="eyebrow">Practical resources</p><h2>Think globally. Prepare rigorously. Stay grounded.</h2><p class="large-copy">Frameworks and questions—not promises of admission, visa approval or employment.</p></div><ul><% page.data.resources.forEach((resource, index) => { %><li><span><%= String(index + 1).padStart(2, '0') %></span><%= resource %></li><% }) %></ul></div></section>
<%- include('../components/cta.ejs', { cta: { title: 'Build a career that can continue to grow.', route: '/notebook/', label: 'Explore the Notebook' } }) %>
