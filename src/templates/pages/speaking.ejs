<section class="page-hero section-dark"><div class="container page-hero-grid"><div><p class="eyebrow eyebrow-light"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1></div><p class="hero-lead"><%= page.data.lead %></p></div></section>
<section class="section"><div class="container"><div class="section-heading narrow"><p class="eyebrow">Proposed session topics</p><h2>Ideas designed for useful discussion.</h2></div><ol class="speaking-list"><% page.data.topics.forEach((topic, index) => { %><li><span><%= String(index + 1).padStart(2, '0') %></span><div><h2><%= topic.title %></h2><p><%= topic.body %></p></div></li><% }) %></ol></div></section>
<section class="section section-sage"><div class="container split-layout"><div><p class="eyebrow">Invitation guidance</p><h2>Invite a meaningful discussion.</h2></div><div><p class="large-copy">Share the event objectives, audience profile, delivery format, proposed date and location, and any expected preparatory work.</p><p>Availability and participation terms will be discussed case by case. No placeholder events or media appearances are represented here.</p><a class="button button-outline" href="<%= urlFor('/contact/') %>">Submit a Speaking Inquiry</a></div></div></section>
