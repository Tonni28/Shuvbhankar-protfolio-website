<section class="page-hero section-dark"><div class="container page-hero-grid"><div><p class="eyebrow eyebrow-light"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1></div><div><p class="hero-lead"><%= page.data.lead %></p><p><%= page.data.intro %></p></div></div></section>
<section class="section"><div class="container"><div class="section-heading narrow"><p class="eyebrow">Practice areas</p><h2>From organizational ambition to practical execution.</h2></div><ol class="practice-list"><% page.data.practices.forEach((practice, index) => { %><li><span class="list-number"><%= String(index + 1).padStart(2, '0') %></span><h3><%= practice.title %></h3><p><%= practice.body %></p></li><% }) %></ol></div></section>
<section class="section section-sage"><div class="container"><div class="split-layout section-heading"><div><p class="eyebrow">Method</p><h2>A structured path from challenge to institutional capability.</h2></div><p class="large-copy">Diagnosis and implementation belong in the same conversation.</p></div><ol class="process-steps"><% page.data.process.forEach((step) => { %><li><span><%= step.number %></span><h3><%= step.title %></h3><p><%= step.body %></p></li><% }) %></ol></div></section>
<section class="section"><div class="container frameworks-grid"><div><p class="eyebrow">Approach in practice</p><h2>Frameworks, not unverified case claims.</h2><p>These themes describe ways of examining common institutional challenges. They are not presented as client case histories.</p></div><ol><% page.data.frameworks.forEach((item, index) => { %><li><span>0<%= index + 1 %></span><%= item %></li><% }) %></ol></div></section>
<%- include('../components/cta.ejs', { cta: { eyebrow: 'Organizational inquiry', title: 'Better performance starts with a clearer diagnosis.', body: 'Begin with the question your organization most needs to answer.', label: 'Discuss an Organizational Challenge' } }) %>
