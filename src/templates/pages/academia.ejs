<section class="page-hero section-dark"><div class="container page-hero-grid"><div><p class="eyebrow eyebrow-light"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1></div><p class="hero-lead"><%= page.data.lead %></p></div></section>
<section class="section"><div class="container split-layout"><div><p class="eyebrow">Teaching philosophy</p><h2>Move beyond remembering to reasoning.</h2></div><div class="prose prose-large"><% page.data.philosophy.forEach((paragraph) => { %><p><%= paragraph %></p><% }) %></div></div></section>
<section class="clusters section-sage section"><div class="container"><div class="section-heading narrow"><p class="eyebrow">Teaching & inquiry</p><h2>Knowledge connected across disciplines.</h2></div><ol><% page.data.clusters.forEach((item, index) => { %><li><span>0<%= index + 1 %></span><%= item %></li><% }) %></ol></div></section>
<section class="section"><div class="container research-layout"><div><p class="eyebrow">Research themes</p><h2>Questions with consequences beyond the journal page.</h2></div><div class="research-themes"><% page.data.themes.forEach((theme) => { %><article><h3><%= theme.title %></h3><p><%= theme.body %></p></article><% }) %></div></div></section>
<section class="section section-dark"><div class="container"><div class="section-heading"><div><p class="eyebrow eyebrow-light">Selected publications</p><h2>Verified source links.</h2></div><p>Bibliographic details should be reviewed before public launch.</p></div><%- include('../components/publication-list.ejs') %></div></section>
<%- include('../components/cta.ejs', { cta: { title: 'Research grows through serious conversation.', route: '/contact/', label: 'Discuss Academic Collaboration' } }) %>
