<section class="page-hero about-hero"><div class="container page-hero-grid"><div><p class="eyebrow"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1></div><p class="hero-lead"><%= page.data.lead %></p></div></section>
<section class="chapter-story"><div class="container"><% page.data.chapters.forEach((chapter, index) => { %><article class="story-chapter" id="chapter-<%= chapter.number %>"><div class="chapter-index"><span><%= chapter.number %></span><p><%= chapter.kicker %></p></div><div><h2><%= chapter.title %></h2><div class="prose-large"><% chapter.paragraphs.forEach((p) => { %><p><%= p %></p><% }) %></div></div></article><% }) %></div></section>
<section class="section credentials-section"><div class="container credentials-grid"><div><p class="eyebrow">Credentials, documented</p><h2>Selected qualifications and appointments.</h2></div><ul><% page.data.credentials.forEach((item) => { %><li><%= item %></li><% }) %></ul></div></section>
<section class="section interests-section"><div class="container"><p class="eyebrow">Areas of study & interest</p><div class="tag-cloud"><% page.data.interests.forEach((item) => { %><span><%= item %></span><% }) %></div><div class="recognition"><h2>Recognition</h2><ul><% page.data.recognition.forEach((item) => { %><li><%= item %></li><% }) %></ul></div></div></section>
<%- include('../components/cta.ejs', { cta: { eyebrow: 'What stays constant', title: 'How can an institution earn trust—and a person become ready for responsibility?', body: 'I do not believe those questions can be answered separately.', route: '/work/', label: 'Explore my work' } }) %>

