<section class="page-hero section-dark"><div class="container page-hero-grid"><div><p class="eyebrow eyebrow-light"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1></div><p class="hero-lead"><%= page.data.lead %></p></div></section>
<section class="section"><div class="container biography-grid"><aside><figure class="profile-image-secondary"><img src="<%= asset('assets/images/profile/shubhankar-shil-ulab.jpg') %>" width="500" height="500" loading="lazy" alt="Faculty portrait of Shubhankar Shil in a light-colored blazer"><figcaption><a href="<%= site.externalLinks.ulab %>" target="_blank" rel="noopener noreferrer">Official faculty portrait · ULAB</a></figcaption></figure><p class="caption">Management Advisor · Academic · Researcher · Mentor</p></aside><div class="prose prose-large"><% page.data.biography.forEach((paragraph) => { %><p><%= paragraph %></p><% }) %></div></div></section>
<section class="section section-sage"><div class="container"><div class="split-layout section-heading"><div><p class="eyebrow">Approach & philosophy</p><h2>Think rigorously. Act practically. Keep learning.</h2></div><p class="large-copy">Begin with the real problem. Design a response people can understand, own and improve. Assess outcomes honestly and adapt when evidence changes.</p></div><ol class="value-list"><% page.data.values.forEach((value, index) => { %><li><span>0<%= index + 1 %></span><div><h3><%= value.title %></h3><p><%= value.body %></p></div></li><% }) %></ol></div></section>
<section class="section"><div class="container credentials-grid"><div><p class="eyebrow">Qualifications</p><h2>Professional foundations.</h2><ul class="lined-list"><% page.data.qualifications.forEach((item) => { %><li><%= item %></li><% }) %></ul></div><div><p class="eyebrow">Selected roles</p><h2>Across institutions.</h2><ul class="lined-list"><% page.data.roles.forEach((item) => { %><li><%= item %></li><% }) %></ul></div></div></section>
<section class="source-band section-sage"><div class="container source-band-inner"><div><p class="eyebrow">Research provenance</p><h2>Profile details checked against current institutional sources.</h2></div><div class="source-links"><a href="<%= site.externalLinks.ulab %>" target="_blank" rel="noopener noreferrer"><span>Academic profile</span><strong>University of Liberal Arts Bangladesh</strong><small>Appointment, education, teaching, research and publications ↗</small></a><a href="<%= site.externalLinks.jkmns %>team/shubhankar-shil/" target="_blank" rel="noopener noreferrer"><span>Professional profile</span><strong>JKMNS, Chartered Accountants</strong><small>Firm leadership, qualifications and advisory interests ↗</small></a></div></div></section>
