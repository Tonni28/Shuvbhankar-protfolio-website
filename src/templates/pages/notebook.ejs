<section class="notebook-hero"><div class="container notebook-hero-inner"><p class="eyebrow"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1><p class="hero-lead"><%= page.data.lead %></p><div class="notebook-rule" aria-hidden="true"></div><p class="large-copy"><%= page.data.intro %></p></div></section>
<section class="section"><div class="container notebook-layout"><aside><p class="eyebrow">Recurring questions</p><ul><% page.data.topics.forEach((topic) => { %><li><%= topic %></li><% }) %></ul></aside><div><% const notes = articles.filter((item) => item.type === 'notebook'); if (notes.length) { %><p class="status-pill">Preview · Author review</p><% notes.forEach((article) => { %><%- include('../components/article-card.ejs', { article }) %><% }) %><% } else { %><div class="empty-editorial"><h2>New reflections are being prepared.</h2><p>Personal notebook entries will appear here after editorial approval.</p><a class="arrow-link" href="<%= urlFor('/insights/') %>">Explore published research <span aria-hidden="true">↗</span></a></div><% } %></div></div></section>
<section class="notebook-quote section-dark"><div class="container"><blockquote>The most useful lesson is often the one that changes the question we ask next.</blockquote></div></section>
