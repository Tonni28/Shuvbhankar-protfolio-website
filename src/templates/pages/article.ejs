<% const article=page.data.article; const words=article.body.flatMap(s=>s.paragraphs).join(' ').split(/\s+/).length; const minutes=Math.max(1,Math.ceil(words/220)); %><article class="article-page"><header class="article-hero <%= article.type==='blog'?'article-hero-blog':'section-dark' %>"><div class="container article-hero-inner"><a class="back-link" href="<%= urlFor(article.type==='blog'?'/blogs/':'/insights/') %>">← Back to <%= article.type==='blog'?'Blogs':'Insights' %></a><p class="eyebrow <%= article.type==='insight'?'eyebrow-light':'' %>"><%= article.category %> / <%= article.type %></p><h1><%= article.title %></h1><p class="hero-lead"><%= article.deck %></p><div class="article-byline"><span>By <%= article.author %></span><span><%= minutes %> min read</span><span class="status-pill">Editorial draft — awaiting author approval</span></div></div></header><div class="container article-layout"><aside class="article-toc"><p class="eyebrow">Contents</p><ol><% article.body.forEach((section,i)=>{ %><li><a href="#section-<%= i+1 %>"><%= section.heading %></a></li><% }) %></ol><div class="article-tools"><button type="button" data-copy-link>Copy link</button><button type="button" data-print>Print</button></div></aside><div class="article-body"><p class="editorial-notice"><strong>Editorial preview:</strong> This proposed essay is provided for author review. It is not presented as a previously published opinion or authenticated recollection.</p><% article.body.forEach((section,i)=>{ %><section id="section-<%= i+1 %>"><h2><%= section.heading %></h2><% section.paragraphs.forEach((p)=>{ %><p><%= p %></p><% }) %></section><% }) %><p class="research-disclaimer">This article discusses general principles and should not be treated as tailored legal, tax, investment or professional advice.</p><aside class="author-box"><img src="<%= asset('assets/images/profile/shubhankar-shil-ulab.jpg') %>" width="500" height="500" alt="Shubhankar Shil in a professional portrait."><div><p class="eyebrow">About the author</p><h2>Shubhankar Shil, FCA</h2><p>Works across governance, management advisory and higher education. He is an Assistant Professor at ULAB and Founder and Managing Partner of JKMNS, Chartered Accountants.</p></div></aside></div></div></article>

