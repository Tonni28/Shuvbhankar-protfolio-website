<% const article = page.data.article; %>
<article class="article-page">
  <header class="article-hero section-dark"><div class="container article-hero-inner"><a class="back-link" href="<%= urlFor(article.type === 'notebook' ? '/notebook/' : '/insights/') %>">← Back to <%= article.type === 'notebook' ? 'Notebook' : 'Insights' %></a><p class="eyebrow eyebrow-light"><%= article.category %></p><h1><%= article.title %></h1><p class="hero-lead"><%= article.description %></p><div class="article-byline"><span><%= article.author %></span><span><%= article.readingMinutes %> minute read</span><span class="status-pill status-dark">Draft for author approval</span></div></div></header>
  <div class="container article-layout"><aside class="article-toc"><p class="eyebrow">On this page</p><ol><% article.body.forEach((section, index) => { const anchor = `section-${index + 1}`; %><li><a href="#<%= anchor %>"><%= section.heading %></a></li><% }) %></ol><button class="copy-link" type="button" data-copy-link>Copy article link</button></aside><div class="article-body"><p class="editorial-notice"><strong>Editorial preview:</strong> This original draft is provided for private author review and is not presented as a published opinion.</p><% article.body.forEach((section, index) => { %><section id="section-<%= index + 1 %>"><h2><%= section.heading %></h2><% section.paragraphs.forEach((paragraph) => { %><p><%= paragraph %></p><% }) %></section><% }) %><footer class="article-end"><p>Continue the inquiry.</p><a class="arrow-link" href="<%= urlFor('/insights/') %>">Explore related thinking <span aria-hidden="true">↗</span></a></footer></div></div>
</article>
