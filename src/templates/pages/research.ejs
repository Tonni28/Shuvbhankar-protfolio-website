<section class="page-hero research-hero"><div class="container page-hero-grid"><div><p class="eyebrow"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1></div><p class="hero-lead"><%= page.data.lead %></p></div></section>
<section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Featured research</p><h2>Questions examined through evidence.</h2></div><div class="publication-feature-grid"><% publications.filter(p=>p.featured).forEach((p)=>{ %><article><span><%= p.year %> · <%= p.type %></span><h2><%= p.title %></h2><p><%= p.authors %></p><p><%= p.outlet %></p><a class="arrow-link" href="<%= p.url %>" target="_blank" rel="noopener noreferrer">Read source <span aria-hidden="true">↗</span></a></article><% }) %></div></div></section>
<section class="section section-sage"><div class="container"><div class="section-heading"><p class="eyebrow">Selected journal work</p><h2>A browsable record.</h2></div><%- include('../components/publication-list.ejs') %></div></section><section class="section"><div class="container research-conferences"><div><p class="eyebrow">Selected conference contributions</p><h2>Ideas shared in academic conversation.</h2></div><ol><% page.data.conferences.forEach((item)=>{ %><li><%= item %></li><% }) %></ol></div></section><%- include('../components/cta.ejs', { cta: { eyebrow: 'Research closing', title: 'Evidence does not make difficult choices easy.', body: 'It makes our reasoning more accountable.', route: '/insights/', label: 'Read related insights' } }) %>

