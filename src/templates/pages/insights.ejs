<section class="page-hero section-dark"><div class="container page-hero-grid"><div><p class="eyebrow eyebrow-light"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1></div><div><p class="hero-lead"><%= page.data.lead %></p><p class="preview-note">Insights distinguish evidence from interpretation. Hypothetical examples are identified.</p></div></div></section>
<section class="section archive-section"><div class="container"><div class="filter-bar" data-filter-bar><label class="search-field"><span>Search the library</span><input type="search" placeholder="Search ideas, subjects or titles" data-article-search></label><fieldset><legend>Explore by topic</legend><div class="filter-options"><% page.data.topics.forEach((topic,index)=>{ %><label><input type="radio" name="topic" value="<%= topic %>" <%= index===0?'checked':'' %>><span><%= topic %></span></label><% }) %></div></fieldset></div><% const posts=articles.filter(a=>a.type==='insight'); %><% if(posts.length){ %><div class="article-grid" data-article-grid><% posts.forEach((article)=>{ %><%- include('../components/article-card.ejs',{article}) %><% }) %></div><p class="empty-state" data-empty-state hidden>No essays match these filters. Clear filters to see the complete library.</p><% } else { %><div class="empty-editorial"><p class="eyebrow">Editorial review in progress</p><h2>Research-informed essays are being prepared.</h2><p>Six complete drafts are held for author approval and are not shown in the public archive.</p></div><% } %></div></section>
<section class="section research-gateway"><div class="container split-heading"><div><p class="eyebrow">Research gateway</p><h2>The research behind the questions.</h2></div><div><p>Academic publications and conference contributions spanning governance, finance, markets, technology and business institutions.</p><a class="button button-outline" href="<%= urlFor('/insights/research/') %>">Explore publications</a></div></div></section>

