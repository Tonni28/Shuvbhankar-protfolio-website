<section class="page-hero section-dark"><div class="container page-hero-grid"><div><p class="eyebrow eyebrow-light"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1></div><p class="hero-lead"><%= page.data.lead %></p></div></section>
<section class="section contact-routes"><div class="container"><p class="eyebrow">Ways to begin</p><div class="route-grid"><% page.data.routes.forEach((item,i)=>{ %><article><span>0<%= i+1 %></span><h2><%= item[0] %></h2><p><%= item[1] %></p></article><% }) %></div></div></section>
<section class="section contact-form-section"><div class="container contact-layout"><aside><p class="eyebrow">Tell me what you are working on</p><h2>Good work begins with clarity. Let's start there.</h2><p>Please share the objective, timeline and relevant context. Submission does not establish an advisory or mentorship engagement.</p><a class="arrow-link" href="<%= site.externalLinks.jkmns %>" target="_blank" rel="noopener noreferrer">Firm-related inquiries at JKMNS <span aria-hidden="true">↗</span></a></aside><form class="contact-form" action="<%= site.contact.formAction %>" method="post" data-contact-form novalidate>
<div class="form-grid"><div class="field"><label for="name">Full name</label><input id="name" name="name" autocomplete="name" required minlength="2"><span class="field-error" data-error-for="name"></span></div><div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required><span class="field-error" data-error-for="email"></span></div></div>
<div class="field"><label for="organization">Organization <span>Optional</span></label><input id="organization" name="organization" autocomplete="organization"></div><div class="field"><label for="category">Type of inquiry</label><select id="category" name="category" required><option value="">Choose one</option><% page.data.categories.forEach((category)=>{ %><option><%= category %></option><% }) %></select><span class="field-error" data-error-for="category"></span></div><div class="field"><label for="subject">Subject</label><input id="subject" name="subject" required minlength="5"><span class="field-error" data-error-for="subject"></span></div><div class="field"><label for="message">Your message</label><textarea id="message" name="message" rows="7" required minlength="30" placeholder="A short description of your objective, timeline and context is helpful."></textarea><span class="field-error" data-error-for="message"></span></div><label class="check-field"><input type="checkbox" name="consent" required><span>I agree that my information may be used to respond to this inquiry, as described in the <a href="<%= urlFor('/privacy/') %>">Privacy Notice</a>.</span></label><% if(site.contact.formAction){ %><button class="button button-gold" type="submit">Send inquiry</button><% } else { %><div class="form-config-note" role="note"><strong>Form delivery is not configured.</strong><span>No information is submitted or stored. Add a reviewed form endpoint before launch.</span></div><button class="button button-gold" type="submit" disabled>Send inquiry</button><% } %></form></div></section>

