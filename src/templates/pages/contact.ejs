<section class="contact-hero section-dark"><div class="container page-hero-grid"><div><p class="eyebrow eyebrow-light"><%= page.data.eyebrow %></p><h1><%= page.data.heading %></h1></div><p class="hero-lead"><%= page.data.lead %></p></div></section>
<section class="section"><div class="container contact-layout"><aside><p class="eyebrow">Before you write</p><h2>A clear initial message helps identify the next step.</h2><p>Professional and academic commitments may affect response times. Submission does not establish an advisory or mentorship engagement.</p><a class="arrow-link" href="<%= site.externalLinks.jkmns %>" target="_blank" rel="noopener noreferrer">Explore the JKMNS website <span aria-hidden="true">↗</span></a></aside><form class="contact-form" action="<%= site.contact.formAction %>" method="post" data-contact-form novalidate>
  <div class="form-grid"><div class="field"><label for="name">Full name</label><input id="name" name="name" autocomplete="name" minlength="2" maxlength="100" required><span class="field-error" data-error-for="name"></span></div><div class="field"><label for="email">Professional email</label><input id="email" name="email" type="email" autocomplete="email" required><span class="field-error" data-error-for="email"></span></div></div>
  <div class="field"><label for="organization">Organization / institution <span>Optional</span></label><input id="organization" name="organization" autocomplete="organization"></div>
  <div class="field"><label for="category">Inquiry category</label><select id="category" name="category" required><option value="">Choose one</option><% page.data.categories.forEach((category) => { %><option><%= category %></option><% }) %></select><span class="field-error" data-error-for="category"></span></div>
  <div class="field"><label for="subject">Subject</label><input id="subject" name="subject" minlength="5" maxlength="140" required><span class="field-error" data-error-for="subject"></span></div>
  <div class="field"><label for="message">Message</label><textarea id="message" name="message" rows="7" minlength="30" maxlength="4000" required></textarea><span class="field-error" data-error-for="message"></span></div>
  <div class="honeypot" aria-hidden="true"><label for="company-site">Company website</label><input id="company-site" name="company_site" tabindex="-1" autocomplete="off"></div>
  <label class="check-field"><input type="checkbox" name="consent" required><span>I agree to the use of these details to respond to my inquiry.</span></label>
  <% if (site.contact.formAction) { %><button class="button button-gold" type="submit">Send Inquiry</button><% } else { %><div class="form-config-note" role="note"><strong>Form delivery is not configured.</strong><span>No information is submitted or stored in this preview. Add a reviewed form endpoint before launch.</span></div><button class="button button-gold" type="submit" disabled>Send Inquiry</button><% } %>
</form></div></section>
