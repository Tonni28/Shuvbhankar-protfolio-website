<article class="article-card" data-article data-category="<%= article.category %>" data-search="<%= `${article.title} ${article.description} ${article.tags.join(' ')}`.toLowerCase() %>">
  <div class="article-card-meta"><span><%= article.type === 'notebook' ? 'Notebook' : 'Insight' %></span><span><%= article.readingMinutes %> min read</span></div>
  <h2><a href="<%= urlFor(article.route) %>"><%= article.title %></a></h2>
  <p><%= article.description %></p>
  <div class="article-card-foot"><span><%= article.category %></span><a class="arrow-link" href="<%= urlFor(article.route) %>" aria-label="Read <%= article.title %>">Read <span aria-hidden="true">↗</span></a></div>
</article>
