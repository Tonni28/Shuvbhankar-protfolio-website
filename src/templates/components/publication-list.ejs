<ol class="publication-list"><% publications.filter(p=>!p.featured).forEach((p)=>{ %><li><span class="publication-year"><%= p.year %></span><div><p class="publication-type"><%= p.type %></p><h3><%= p.title %></h3><p><%= p.authors %> · <%= p.outlet %></p></div><% if (p.url) { %><a class="arrow-link" href="<%= p.url %>" target="_blank" rel="noopener noreferrer"><%= p.linkLabel || 'Read paper' %> <span aria-hidden="true">↗</span></a><% } else { %><span class="publication-unavailable">Paper link unavailable</span><% } %></li><% }) %></ol>

