<ol class="publication-list">
  <% publications.forEach((publication) => { %>
    <li>
      <span class="publication-year"><%= publication.year %></span>
      <div><h3><%= publication.title %></h3><p><%= publication.authors %> · <%= publication.outlet %></p></div>
      <a class="arrow-link" href="<%= publication.url %>" target="_blank" rel="noopener noreferrer">View source <span aria-hidden="true">↗</span></a>
    </li>
  <% }) %>
</ol>
