<footer class="site-footer">
  <div class="container footer-lead">
    <div><p class="eyebrow eyebrow-light">Keep the conversation going</p><p class="footer-title">People.<br>Systems.<br><em>Progress.</em></p></div>
    <p>Writing and work at the intersection of governance, management, education and human potential.</p>
  </div>
  <div class="container footer-grid">
    <div><p class="footer-label">Explore</p><ul><% navigation.footer.explore.forEach((item) => { %><li><a href="<%= urlFor(item.route) %>"><%= item.label %></a></li><% }) %></ul></div>
    <div><p class="footer-label">Connect</p><ul><% navigation.footer.connect.forEach((item) => { %><li><a href="<%= urlFor(item.route) %>"><%= item.label %></a></li><% }) %><li><a href="<%= site.externalLinks.jkmns %>" target="_blank" rel="noopener noreferrer">JKMNS ↗</a></li><li><a href="<%= site.externalLinks.ulab %>" target="_blank" rel="noopener noreferrer">ULAB profile ↗</a></li></ul></div>
    <div><p class="footer-label">Notes</p><ul><% navigation.footer.legal.forEach((item) => { %><li><a href="<%= urlFor(item.route) %>"><%= item.label %></a></li><% }) %></ul></div>
  </div>
  <div class="container footer-bottom"><p>© <span data-current-year></span> <%= site.shortName %>. All rights reserved.</p><p>Views in personal essays do not necessarily represent affiliated institutions.</p><a href="#main-content">Return to top ↑</a></div>
</footer>

