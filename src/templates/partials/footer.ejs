<footer class="site-footer">
  <% const footerLinks = navigation.primary.flatMap((item) => item.children && item.children.length ? item.children : item.route ? [item] : []); %>
  <div class="container footer-main">
    <div class="footer-brand-block">
      <a class="footer-brand" href="<%= urlFor('/') %>" aria-label="<%= site.shortName %> — home">
        <img src="<%= asset('assets/images/profile/8a897ec8-8db1-4e68-958c-f13abebc0a53.png') %>" width="2172" height="724" alt="">
      </a>
      <p>Perspectives on people, organizations, education and the systems that connect them.</p>
    </div>
    <nav class="footer-menu" aria-label="Footer navigation">
      <p class="footer-section-label">Navigate</p>
      <ul><% footerLinks.forEach((item) => { %><li><a href="<%= urlFor(item.route) %>"><%= item.label %></a></li><% }) %></ul>
    </nav>
    <div class="footer-contact">
      <p class="footer-section-label">Email</p>
      <a class="footer-email" href="mailto:<%= site.contact.email %>"><%= site.contact.email %></a>
      <p class="footer-section-label footer-social-label">Follow</p>
      <div class="footer-socials">
        <a href="<%= site.social.linkedin %>" target="_blank" rel="noopener noreferrer" aria-label="Shubhankar Consulting on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/></svg></a>
        <a href="<%= site.social.facebook %>" target="_blank" rel="noopener noreferrer" aria-label="Shubhankar Consulting on Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.438H7.078v-3.489h3.047V9.413c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.973h-1.513c-1.49 0-1.956.93-1.956 1.887v2.261h3.328l-.532 3.489h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg></a>
        <a href="<%= site.social.youtube %>" target="_blank" rel="noopener noreferrer" aria-label="Shubhankar Consulting on YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
      </div>
    </div>
  </div>
  <div class="container footer-copyright">
    <p>&copy; <span data-current-year></span> <%= site.shortName %>. All rights reserved.</p>
    <p class="footer-powered"><span>Powered by</span><a href="https://hoshonto.com" target="_blank" rel="noopener noreferrer"><img src="https://jkmns.com/assets/logos/hoshonto.svg" width="224" height="232" alt="">Hoshonto Technology</a></p>
  </div>
</footer>

